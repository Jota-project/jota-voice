# Nombre del dispositivo (para logs y mensajes)
DEVICE_NAME="salon"

# Conexión SSH
PHONE_HOST="192.168.X.X"
PHONE_PORT="8022"
PHONE_USER="tu-usuario"
# Recomendado: autenticación por clave SSH y PHONE_PASS vacío
#   ssh-copy-id -p 8022 tu-usuario@192.168.X.X
# Si usas contraseña, deploy.sh se la pasa a sshpass por entorno (-e), no
# por argumento. Este fichero queda en 600 (deploy.sh / instaladores).
PHONE_PASS=""

# Directorio del repo en el teléfono
PHONE_DIR="/data/data/com.termux/files/home/jota-voice"
